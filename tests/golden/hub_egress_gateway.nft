table inet kornode {
  set fabric_ifaces {
    type ifname;
  }
  set transit_ifaces {
    type ifname;
  }
  set local_v4 {
    type ipv4_addr;
    flags interval;
    auto-merge;
  }
  set local_v6 {
    type ipv6_addr;
    flags interval;
    auto-merge;
  }
  set carrier_v4 {
    type ipv4_addr;
    flags interval;
    auto-merge;
  }
  set carrier_v6 {
    type ipv6_addr;
    flags interval;
    auto-merge;
  }
  set fabric_v4 {
    type ipv4_addr;
    flags interval;
    auto-merge;
  }
  set fabric_v6 {
    type ipv6_addr;
    flags interval;
    auto-merge;
  }
  set transit3_v4 {
    type ipv4_addr;
    flags interval;
    auto-merge;
  }
  chain validate_connection {
    ct mark & 0xffffff00 == 0x0cc21400 ct label == (0 | 2 | 4 | 6 | 8 | 10 | 14 | 16 | 17 | 24 | 25 | 27 | 29 | 30 | 33 | 34 | 35 | 37 | 38 | 40 | 45 | 50 | 51 | 52 | 54 | 57 | 58 | 61 | 71 | 72 | 73 | 74 | 76 | 77 | 80 | 81 | 84 | 85 | 86 | 87 | 89 | 90 | 94 | 97 | 98 | 101 | 102 | 103 | 104 | 105 | 107 | 108 | 109 | 110 | 111 | 115 | 119 | 120 | 124 | 127) return
    drop
  }
  chain session_rpf {
    iifname @transit_ifaces ct direction reply ct state established,related return
    # strict reverse path for ocserv sessions: a session may only use a source address routed back through its own device (D-47)
    iifname "vpns*" meta nfproto ipv4 fib saddr . iif oif missing drop
  }
  chain prerouting {
    type filter hook prerouting priority mangle; policy accept;
    jump session_rpf
    ct mark & 0xff000000 == 0x0c000000 meta mark set ct mark goto validate_connection
    jump egress_classify
  }
  chain egress_classify {
    fib daddr type local return
    ip daddr @local_v4 return
    ip6 daddr @local_v6 return
    ip daddr @carrier_v4 return
    ip6 daddr @carrier_v6 return
    iifname @fabric_ifaces ip daddr @fabric_v4 return comment "agents: fabric destinations are routed"
    iifname @fabric_ifaces ip6 daddr @fabric_v6 return comment "agents: fabric destinations are routed"
    iifname @fabric_ifaces ip saddr @transit3_v4 meta mark set 0x0cc21400 ct mark set meta mark ct label set (0 | 2 | 4 | 6 | 8 | 10 | 14 | 16 | 17 | 24 | 25 | 27 | 29 | 30 | 33 | 34 | 35 | 37 | 38 | 40 | 45 | 50 | 51 | 52 | 54 | 57 | 58 | 61 | 71 | 72 | 73 | 74 | 76 | 77 | 80 | 81 | 84 | 85 | 86 | 87 | 89 | 90 | 94 | 97 | 98 | 101 | 102 | 103 | 104 | 105 | 107 | 108 | 109 | 110 | 111 | 115 | 119 | 120 | 124 | 127) goto validate_connection comment "transit node:3"
    ip saddr 10.100.1.0/24 meta mark set 0x0cc21400 ct mark set meta mark ct label set (0 | 2 | 4 | 6 | 8 | 10 | 14 | 16 | 17 | 24 | 25 | 27 | 29 | 30 | 33 | 34 | 35 | 37 | 38 | 40 | 45 | 50 | 51 | 52 | 54 | 57 | 58 | 61 | 71 | 72 | 73 | 74 | 76 | 77 | 80 | 81 | 84 | 85 | 86 | 87 | 89 | 90 | 94 | 97 | 98 | 101 | 102 | 103 | 104 | 105 | 107 | 108 | 109 | 110 | 111 | 115 | 119 | 120 | 124 | 127) goto validate_connection comment "egress rule 0"
    iifname "wg0" ip saddr 10.8.1.0/24 meta mark set 0x0cc21400 ct mark set meta mark ct label set (0 | 2 | 4 | 6 | 8 | 10 | 14 | 16 | 17 | 24 | 25 | 27 | 29 | 30 | 33 | 34 | 35 | 37 | 38 | 40 | 45 | 50 | 51 | 52 | 54 | 57 | 58 | 61 | 71 | 72 | 73 | 74 | 76 | 77 | 80 | 81 | 84 | 85 | 86 | 87 | 89 | 90 | 94 | 97 | 98 | 101 | 102 | 103 | 104 | 105 | 107 | 108 | 109 | 110 | 111 | 115 | 119 | 120 | 124 | 127) goto validate_connection comment "egress rule 0"
    ip saddr 10.100.1.0/24 reject with icmpx admin-prohibited comment "egress rule 1"
    iifname "wg0" ip saddr 10.8.1.0/24 reject with icmpx admin-prohibited comment "egress rule 1"
    iifname @fabric_ifaces reject with icmpx admin-prohibited comment "agents: no exit declared"
  }
  chain output {
    type route hook output priority mangle; policy accept;
    ct mark & 0xff000000 == 0x0c000000 meta mark set ct mark goto validate_connection
    jump egress_classify_host
  }
  chain egress_classify_host {
    ct direction reply return
    fib daddr type local return
    ip daddr @local_v4 return
    ip6 daddr @local_v6 return
    ip daddr @carrier_v4 return
    ip6 daddr @carrier_v6 return
  }
  chain input {
    type filter hook input priority mangle; policy accept;
    ip saddr 10.99.255.240/28 ip daddr 10.99.0.1 tcp dport 8444 accept
    ip saddr 10.99.255.240/28 drop
  }
  chain forward {
    type filter hook forward priority filter; policy accept;
    ip saddr 10.99.255.240/28 drop
    ip daddr 10.99.255.240/28 drop
    tcp flags syn / syn,rst tcp option maxseg size set rt mtu
    meta mark & 0xffffff00 { 0x0cc21400 } oifname "eth0" reject with icmpx admin-prohibited
    meta mark & 0xff000000 == 0x0c000000 meta mark & 0xffffff00 != { 0x0cc21400 } reject with icmpx admin-prohibited
  }
  chain postrouting {
    type filter hook postrouting priority filter; policy accept;
    oifname "lo" accept
    tcp flags syn / syn,rst tcp option maxseg size set rt mtu
    meta mark & 0xffffff00 { 0x0cc21400 } oifname "eth0" drop
    meta mark & 0xff000000 == 0x0c000000 meta mark & 0xffffff00 != { 0x0cc21400 } drop
  }
}
table ip kornode_nat {
  chain postrouting {
    type nat hook postrouting priority srcnat; policy accept;
    ip saddr 10.100.1.0/24 ip daddr != 10.100.1.0/24 meta mark & 0xffffff00 == 0x00000000 masquerade
    ip saddr 10.8.1.0/24 ip daddr != 10.8.1.0/24 meta mark & 0xffffff00 == 0x00000000 masquerade
  }
}
