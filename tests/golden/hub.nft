table inet kornode {
  set fabric_ifaces {
    type ifname;
  }
  set local_v4 {
    type ipv4_addr;
    flags interval;
    auto-merge;
  }
  set local_v6 {
    type ipv6_addr;
    flags interval;
    auto-merge;
  }
  set carrier_v4 {
    type ipv4_addr;
    flags interval;
    auto-merge;
  }
  set carrier_v6 {
    type ipv6_addr;
    flags interval;
    auto-merge;
  }
  set corp_v4 {
    type ipv4_addr;
    flags interval;
    auto-merge;
  }
  set corp_v6 {
    type ipv6_addr;
    flags interval;
    auto-merge;
  }
  set fabric_v4 {
    type ipv4_addr;
    flags interval;
    auto-merge;
  }
  set fabric_v6 {
    type ipv6_addr;
    flags interval;
    auto-merge;
  }
  chain prerouting {
    type filter hook prerouting priority mangle; policy accept;
    ct mark & 0xff000000 == 0x0c000000 meta mark set ct mark return
    jump egress_classify
  }
  chain egress_classify {
    fib daddr type local return
    ip daddr @local_v4 return
    ip6 daddr @local_v6 return
    ip daddr @carrier_v4 return
    ip6 daddr @carrier_v6 return
    ip saddr 10.100.1.0/24 ip daddr @fabric_v4 meta mark set 0x0c000100 ct mark set meta mark accept comment "egress rule 0"
    iifname @fabric_ifaces ip daddr @fabric_v4 meta mark set 0x0c000100 ct mark set meta mark accept comment "egress rule 0"
    iifname @fabric_ifaces ip6 daddr @fabric_v6 meta mark set 0x0c000100 ct mark set meta mark accept comment "egress rule 0"
    ip saddr 10.100.1.0/24 ip daddr @corp_v4 meta mark set 0x0c000200 ct mark set meta mark accept comment "egress rule 1"
    iifname @fabric_ifaces meta mark set 0x0c000300 ct mark set meta mark accept comment "egress rule 2"
    ip saddr 10.100.1.0/24 meta mark set 0x0c000300 ct mark set meta mark accept comment "egress rule 3"
    ip saddr 10.100.1.0/24 reject with icmpx admin-prohibited comment "egress rule 4"
  }
  chain output {
    type route hook output priority mangle; policy accept;
    ct mark & 0xff000000 == 0x0c000000 meta mark set ct mark return
    jump egress_classify_host
  }
  chain egress_classify_host {
    ct direction reply return
    fib daddr type local return
    ip daddr @local_v4 return
    ip6 daddr @local_v6 return
    ip daddr @carrier_v4 return
    ip6 daddr @carrier_v6 return
    ip daddr @fabric_v4 meta mark set 0x0c000100 ct mark set meta mark accept comment "egress rule 0"
    ip6 daddr @fabric_v6 meta mark set 0x0c000100 ct mark set meta mark accept comment "egress rule 0"
    ip daddr @corp_v4 meta mark set 0x0c000200 ct mark set meta mark accept comment "egress rule 1"
    ip6 daddr @corp_v6 meta mark set 0x0c000200 ct mark set meta mark accept comment "egress rule 1"
  }
  chain input {
    type filter hook input priority mangle; policy accept;
    ct state new iifname "oc-office0" ct mark set 0x0c000200
  }
  chain forward {
    type filter hook forward priority filter; policy accept;
    tcp flags syn / syn,rst tcp option maxseg size set rt mtu
    meta mark & 0xffffff00 { 0x0c000100, 0x0c000200 } oifname "eth0" reject with icmpx admin-prohibited
    meta mark & 0xff000000 == 0x0c000000 meta mark & 0xffffff00 != { 0x0c000100, 0x0c000200, 0x0c000300 } oifname "eth0" reject with icmpx admin-prohibited
  }
  chain postrouting {
    type filter hook postrouting priority filter; policy accept;
    oifname "lo" accept
    tcp flags syn / syn,rst tcp option maxseg size set rt mtu
    meta mark & 0xffffff00 { 0x0c000100, 0x0c000200 } oifname "eth0" drop
    meta mark & 0xff000000 == 0x0c000000 meta mark & 0xffffff00 != { 0x0c000100, 0x0c000200, 0x0c000300 } oifname "eth0" drop
  }
}
table ip kornode_nat {
  chain postrouting {
    type nat hook postrouting priority srcnat; policy accept;
    meta mark & 0xffffff00 == 0x0c000200 oifname "oc-office0" masquerade
    meta mark & 0xffffff00 == 0x0c000300 oifname != "lo" masquerade
    ip saddr 10.100.1.0/24 ip daddr != 10.100.1.0/24 meta mark & 0xffffff00 == 0x00000000 masquerade
  }
}
