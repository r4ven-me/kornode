table inet kornode {
  set interlink_ifaces {
    type ifname;
  }
  set local_v4 {
    type ipv4_addr;
    flags interval;
    auto-merge;
  }
  set local_v6 {
    type ipv6_addr;
    flags interval;
    auto-merge;
  }
  set carrier_v4 {
    type ipv4_addr;
    flags interval;
    auto-merge;
  }
  set carrier_v6 {
    type ipv6_addr;
    flags interval;
    auto-merge;
  }
  set corp_v4 {
    type ipv4_addr;
    flags interval;
    auto-merge;
  }
  set corp_v6 {
    type ipv6_addr;
    flags interval;
    auto-merge;
  }
  set interlink_v4 {
    type ipv4_addr;
    flags interval;
    auto-merge;
  }
  set interlink_v6 {
    type ipv6_addr;
    flags interval;
    auto-merge;
  }
  chain validate_connection {
    ct mark & 0xffffff00 == 0x0c800100 ct label == (1 | 3 | 4 | 5 | 6 | 7 | 8 | 9 | 13 | 14 | 15 | 17 | 18 | 20 | 21 | 22 | 23 | 24 | 26 | 31 | 32 | 34 | 35 | 36 | 37 | 38 | 39 | 40 | 42 | 43 | 47 | 49 | 50 | 53 | 54 | 55 | 56 | 61 | 64 | 65 | 67 | 70 | 71 | 72 | 74 | 76 | 79 | 80 | 83 | 84 | 89 | 91 | 92 | 93 | 95 | 96 | 97 | 98 | 99 | 102 | 105 | 106 | 107 | 109 | 110 | 111 | 114 | 115 | 116 | 117 | 119 | 121 | 122 | 124 | 125) return
    ct mark & 0xffffff00 == 0x0cc63d00 ct label == (0 | 5 | 6 | 7 | 8 | 9 | 12 | 13 | 14 | 15 | 17 | 22 | 24 | 25 | 26 | 27 | 28 | 30 | 31 | 36 | 39 | 40 | 42 | 43 | 44 | 49 | 50 | 52 | 55 | 59 | 61 | 63 | 64 | 65 | 66 | 69 | 72 | 76 | 77 | 78 | 79 | 80 | 81 | 83 | 84 | 85 | 88 | 90 | 91 | 93 | 95 | 96 | 99 | 100 | 102 | 104 | 106 | 107 | 108 | 109 | 112 | 114 | 116 | 117 | 121 | 125 | 126 | 127) return
    ct mark & 0xffffff00 == 0x0c800000 ct label == (1 | 4 | 5 | 8 | 11 | 12 | 14 | 16 | 18 | 20 | 21 | 22 | 23 | 24 | 26 | 27 | 28 | 29 | 32 | 33 | 35 | 36 | 39 | 41 | 48 | 49 | 50 | 52 | 53 | 56 | 58 | 59 | 63 | 68 | 72 | 76 | 77 | 78 | 79 | 80 | 81 | 84 | 87 | 88 | 89 | 93 | 97 | 99 | 100 | 105 | 106 | 107 | 111 | 112 | 113 | 114 | 115 | 116 | 117 | 119 | 120 | 122 | 125) return
    drop
  }
  chain session_rpf {
    # strict reverse path for ocserv sessions: a session may only use a source address routed back through its own device (D-47)
    iifname "vpns*" meta nfproto ipv4 fib saddr . iif oif missing drop
  }
  chain prerouting {
    type filter hook prerouting priority mangle; policy accept;
    jump session_rpf
    ct mark & 0xff000000 == 0x0c000000 meta mark set ct mark goto validate_connection
    jump egress_classify
  }
  chain egress_classify {
    fib daddr type local return
    ip daddr @local_v4 return
    ip6 daddr @local_v6 return
    ip daddr @carrier_v4 return
    ip6 daddr @carrier_v6 return
    ip saddr 10.100.1.0/24 ip daddr @interlink_v4 meta mark set 0x0c800100 ct mark set meta mark ct label set (1 | 3 | 4 | 5 | 6 | 7 | 8 | 9 | 13 | 14 | 15 | 17 | 18 | 20 | 21 | 22 | 23 | 24 | 26 | 31 | 32 | 34 | 35 | 36 | 37 | 38 | 39 | 40 | 42 | 43 | 47 | 49 | 50 | 53 | 54 | 55 | 56 | 61 | 64 | 65 | 67 | 70 | 71 | 72 | 74 | 76 | 79 | 80 | 83 | 84 | 89 | 91 | 92 | 93 | 95 | 96 | 97 | 98 | 99 | 102 | 105 | 106 | 107 | 109 | 110 | 111 | 114 | 115 | 116 | 117 | 119 | 121 | 122 | 124 | 125) goto validate_connection comment "egress rule 0"
    iifname @interlink_ifaces ip daddr @interlink_v4 meta mark set 0x0c800100 ct mark set meta mark ct label set (1 | 3 | 4 | 5 | 6 | 7 | 8 | 9 | 13 | 14 | 15 | 17 | 18 | 20 | 21 | 22 | 23 | 24 | 26 | 31 | 32 | 34 | 35 | 36 | 37 | 38 | 39 | 40 | 42 | 43 | 47 | 49 | 50 | 53 | 54 | 55 | 56 | 61 | 64 | 65 | 67 | 70 | 71 | 72 | 74 | 76 | 79 | 80 | 83 | 84 | 89 | 91 | 92 | 93 | 95 | 96 | 97 | 98 | 99 | 102 | 105 | 106 | 107 | 109 | 110 | 111 | 114 | 115 | 116 | 117 | 119 | 121 | 122 | 124 | 125) goto validate_connection comment "egress rule 0"
    iifname @interlink_ifaces ip6 daddr @interlink_v6 meta mark set 0x0c800100 ct mark set meta mark ct label set (1 | 3 | 4 | 5 | 6 | 7 | 8 | 9 | 13 | 14 | 15 | 17 | 18 | 20 | 21 | 22 | 23 | 24 | 26 | 31 | 32 | 34 | 35 | 36 | 37 | 38 | 39 | 40 | 42 | 43 | 47 | 49 | 50 | 53 | 54 | 55 | 56 | 61 | 64 | 65 | 67 | 70 | 71 | 72 | 74 | 76 | 79 | 80 | 83 | 84 | 89 | 91 | 92 | 93 | 95 | 96 | 97 | 98 | 99 | 102 | 105 | 106 | 107 | 109 | 110 | 111 | 114 | 115 | 116 | 117 | 119 | 121 | 122 | 124 | 125) goto validate_connection comment "egress rule 0"
    ip saddr 10.100.1.0/24 ip daddr @corp_v4 meta mark set 0x0cc63d00 ct mark set meta mark ct label set (0 | 5 | 6 | 7 | 8 | 9 | 12 | 13 | 14 | 15 | 17 | 22 | 24 | 25 | 26 | 27 | 28 | 30 | 31 | 36 | 39 | 40 | 42 | 43 | 44 | 49 | 50 | 52 | 55 | 59 | 61 | 63 | 64 | 65 | 66 | 69 | 72 | 76 | 77 | 78 | 79 | 80 | 81 | 83 | 84 | 85 | 88 | 90 | 91 | 93 | 95 | 96 | 99 | 100 | 102 | 104 | 106 | 107 | 108 | 109 | 112 | 114 | 116 | 117 | 121 | 125 | 126 | 127) goto validate_connection comment "egress rule 1"
    iifname @interlink_ifaces meta mark set 0x0c800000 ct mark set meta mark ct label set (1 | 4 | 5 | 8 | 11 | 12 | 14 | 16 | 18 | 20 | 21 | 22 | 23 | 24 | 26 | 27 | 28 | 29 | 32 | 33 | 35 | 36 | 39 | 41 | 48 | 49 | 50 | 52 | 53 | 56 | 58 | 59 | 63 | 68 | 72 | 76 | 77 | 78 | 79 | 80 | 81 | 84 | 87 | 88 | 89 | 93 | 97 | 99 | 100 | 105 | 106 | 107 | 111 | 112 | 113 | 114 | 115 | 116 | 117 | 119 | 120 | 122 | 125) goto validate_connection comment "egress rule 2"
    ip saddr 10.100.1.0/24 meta mark set 0x0c800000 ct mark set meta mark ct label set (1 | 4 | 5 | 8 | 11 | 12 | 14 | 16 | 18 | 20 | 21 | 22 | 23 | 24 | 26 | 27 | 28 | 29 | 32 | 33 | 35 | 36 | 39 | 41 | 48 | 49 | 50 | 52 | 53 | 56 | 58 | 59 | 63 | 68 | 72 | 76 | 77 | 78 | 79 | 80 | 81 | 84 | 87 | 88 | 89 | 93 | 97 | 99 | 100 | 105 | 106 | 107 | 111 | 112 | 113 | 114 | 115 | 116 | 117 | 119 | 120 | 122 | 125) goto validate_connection comment "egress rule 3"
    ip saddr 10.100.1.0/24 reject with icmpx admin-prohibited comment "egress rule 4"
  }
  chain output {
    type route hook output priority mangle; policy accept;
    ct mark & 0xff000000 == 0x0c000000 meta mark set ct mark goto validate_connection
    jump egress_classify_host
  }
  chain egress_classify_host {
    ct direction reply return
    fib daddr type local return
    ip daddr @local_v4 return
    ip6 daddr @local_v6 return
    ip daddr @carrier_v4 return
    ip6 daddr @carrier_v6 return
    ip daddr @interlink_v4 meta mark set 0x0c800100 ct mark set meta mark ct label set (1 | 3 | 4 | 5 | 6 | 7 | 8 | 9 | 13 | 14 | 15 | 17 | 18 | 20 | 21 | 22 | 23 | 24 | 26 | 31 | 32 | 34 | 35 | 36 | 37 | 38 | 39 | 40 | 42 | 43 | 47 | 49 | 50 | 53 | 54 | 55 | 56 | 61 | 64 | 65 | 67 | 70 | 71 | 72 | 74 | 76 | 79 | 80 | 83 | 84 | 89 | 91 | 92 | 93 | 95 | 96 | 97 | 98 | 99 | 102 | 105 | 106 | 107 | 109 | 110 | 111 | 114 | 115 | 116 | 117 | 119 | 121 | 122 | 124 | 125) goto validate_connection comment "egress rule 0"
    ip6 daddr @interlink_v6 meta mark set 0x0c800100 ct mark set meta mark ct label set (1 | 3 | 4 | 5 | 6 | 7 | 8 | 9 | 13 | 14 | 15 | 17 | 18 | 20 | 21 | 22 | 23 | 24 | 26 | 31 | 32 | 34 | 35 | 36 | 37 | 38 | 39 | 40 | 42 | 43 | 47 | 49 | 50 | 53 | 54 | 55 | 56 | 61 | 64 | 65 | 67 | 70 | 71 | 72 | 74 | 76 | 79 | 80 | 83 | 84 | 89 | 91 | 92 | 93 | 95 | 96 | 97 | 98 | 99 | 102 | 105 | 106 | 107 | 109 | 110 | 111 | 114 | 115 | 116 | 117 | 119 | 121 | 122 | 124 | 125) goto validate_connection comment "egress rule 0"
    ip daddr @corp_v4 meta mark set 0x0cc63d00 ct mark set meta mark ct label set (0 | 5 | 6 | 7 | 8 | 9 | 12 | 13 | 14 | 15 | 17 | 22 | 24 | 25 | 26 | 27 | 28 | 30 | 31 | 36 | 39 | 40 | 42 | 43 | 44 | 49 | 50 | 52 | 55 | 59 | 61 | 63 | 64 | 65 | 66 | 69 | 72 | 76 | 77 | 78 | 79 | 80 | 81 | 83 | 84 | 85 | 88 | 90 | 91 | 93 | 95 | 96 | 99 | 100 | 102 | 104 | 106 | 107 | 108 | 109 | 112 | 114 | 116 | 117 | 121 | 125 | 126 | 127) goto validate_connection comment "egress rule 1"
    ip6 daddr @corp_v6 meta mark set 0x0cc63d00 ct mark set meta mark ct label set (0 | 5 | 6 | 7 | 8 | 9 | 12 | 13 | 14 | 15 | 17 | 22 | 24 | 25 | 26 | 27 | 28 | 30 | 31 | 36 | 39 | 40 | 42 | 43 | 44 | 49 | 50 | 52 | 55 | 59 | 61 | 63 | 64 | 65 | 66 | 69 | 72 | 76 | 77 | 78 | 79 | 80 | 81 | 83 | 84 | 85 | 88 | 90 | 91 | 93 | 95 | 96 | 99 | 100 | 102 | 104 | 106 | 107 | 108 | 109 | 112 | 114 | 116 | 117 | 121 | 125 | 126 | 127) goto validate_connection comment "egress rule 1"
  }
  chain input {
    type filter hook input priority mangle; policy accept;
    ct state new iifname "oc-office0" ct mark set 0x0cc63d00 ct label set (0 | 5 | 6 | 7 | 8 | 9 | 12 | 13 | 14 | 15 | 17 | 22 | 24 | 25 | 26 | 27 | 28 | 30 | 31 | 36 | 39 | 40 | 42 | 43 | 44 | 49 | 50 | 52 | 55 | 59 | 61 | 63 | 64 | 65 | 66 | 69 | 72 | 76 | 77 | 78 | 79 | 80 | 81 | 83 | 84 | 85 | 88 | 90 | 91 | 93 | 95 | 96 | 99 | 100 | 102 | 104 | 106 | 107 | 108 | 109 | 112 | 114 | 116 | 117 | 121 | 125 | 126 | 127)
    ip saddr 10.99.255.240/28 ip daddr 10.99.0.1 tcp dport 8444 accept
    ip saddr 10.99.255.240/28 drop
  }
  chain forward {
    type filter hook forward priority filter; policy accept;
    ip saddr 10.99.255.240/28 drop
    ip daddr 10.99.255.240/28 drop
    tcp flags syn / syn,rst tcp option maxseg size set rt mtu
    meta mark & 0xffffff00 { 0x0c800100, 0x0cc63d00 } oifname "eth0" reject with icmpx admin-prohibited
    meta mark & 0xff000000 == 0x0c000000 meta mark & 0xffffff00 != { 0x0c800100, 0x0cc63d00, 0x0c800000 } reject with icmpx admin-prohibited
  }
  chain postrouting {
    type filter hook postrouting priority filter; policy accept;
    oifname "lo" accept
    tcp flags syn / syn,rst tcp option maxseg size set rt mtu
    meta mark & 0xffffff00 { 0x0c800100, 0x0cc63d00 } oifname "eth0" drop
    meta mark & 0xff000000 == 0x0c000000 meta mark & 0xffffff00 != { 0x0c800100, 0x0cc63d00, 0x0c800000 } drop
  }
}
table ip kornode_nat {
  chain postrouting {
    type nat hook postrouting priority srcnat; policy accept;
    meta mark & 0xffffff00 == 0x0cc63d00 oifname "oc-office0" masquerade
    meta mark & 0xffffff00 == 0x0c800000 oifname != "lo" masquerade
    ip saddr 10.100.1.0/24 ip daddr != 10.100.1.0/24 meta mark & 0xffffff00 == 0x00000000 masquerade
  }
}
