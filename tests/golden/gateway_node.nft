table inet kornode {
  set fabric_ifaces {
    type ifname;
  }
  set local_v4 {
    type ipv4_addr;
    flags interval;
    auto-merge;
  }
  set local_v6 {
    type ipv6_addr;
    flags interval;
    auto-merge;
  }
  set carrier_v4 {
    type ipv4_addr;
    flags interval;
    auto-merge;
  }
  set carrier_v6 {
    type ipv6_addr;
    flags interval;
    auto-merge;
  }
  set fabric_v4 {
    type ipv4_addr;
    flags interval;
    auto-merge;
  }
  set fabric_v6 {
    type ipv6_addr;
    flags interval;
    auto-merge;
  }
  chain validate_connection {
    ct mark & 0xffffff00 == 0x0c800100 ct label == (0 | 1 | 2 | 5 | 6 | 8 | 10 | 11 | 13 | 16 | 18 | 19 | 20 | 21 | 22 | 24 | 25 | 26 | 27 | 29 | 30 | 32 | 33 | 34 | 35 | 37 | 40 | 43 | 46 | 47 | 49 | 50 | 51 | 53 | 56 | 57 | 58 | 59 | 60 | 64 | 65 | 66 | 67 | 73 | 74 | 80 | 81 | 82 | 86 | 87 | 90 | 95 | 98 | 99 | 101 | 106 | 108 | 110 | 113 | 115 | 117 | 120 | 122 | 123 | 125 | 127) return
    ct mark & 0xffffff00 == 0x0c800000 ct label == (1 | 4 | 5 | 8 | 11 | 12 | 14 | 16 | 18 | 20 | 21 | 22 | 23 | 24 | 26 | 27 | 28 | 29 | 32 | 33 | 35 | 36 | 39 | 41 | 48 | 49 | 50 | 52 | 53 | 56 | 58 | 59 | 63 | 68 | 72 | 76 | 77 | 78 | 79 | 80 | 81 | 84 | 87 | 88 | 89 | 93 | 97 | 99 | 100 | 105 | 106 | 107 | 111 | 112 | 113 | 114 | 115 | 116 | 117 | 119 | 120 | 122 | 125) return
    drop
  }
  chain prerouting {
    type filter hook prerouting priority mangle; policy accept;
    ct mark & 0xff000000 == 0x0c000000 meta mark set ct mark goto validate_connection
    jump egress_classify
  }
  chain egress_classify {
    fib daddr type local return
    ip daddr @local_v4 return
    ip6 daddr @local_v6 return
    ip daddr @carrier_v4 return
    ip6 daddr @carrier_v6 return
    ip saddr 10.100.3.0/24 ip daddr @fabric_v4 meta mark set 0x0c800100 ct mark set meta mark ct label set (0 | 1 | 2 | 5 | 6 | 8 | 10 | 11 | 13 | 16 | 18 | 19 | 20 | 21 | 22 | 24 | 25 | 26 | 27 | 29 | 30 | 32 | 33 | 34 | 35 | 37 | 40 | 43 | 46 | 47 | 49 | 50 | 51 | 53 | 56 | 57 | 58 | 59 | 60 | 64 | 65 | 66 | 67 | 73 | 74 | 80 | 81 | 82 | 86 | 87 | 90 | 95 | 98 | 99 | 101 | 106 | 108 | 110 | 113 | 115 | 117 | 120 | 122 | 123 | 125 | 127) goto validate_connection comment "egress rule 0"
    iifname @fabric_ifaces meta mark set 0x0c800000 ct mark set meta mark ct label set (1 | 4 | 5 | 8 | 11 | 12 | 14 | 16 | 18 | 20 | 21 | 22 | 23 | 24 | 26 | 27 | 28 | 29 | 32 | 33 | 35 | 36 | 39 | 41 | 48 | 49 | 50 | 52 | 53 | 56 | 58 | 59 | 63 | 68 | 72 | 76 | 77 | 78 | 79 | 80 | 81 | 84 | 87 | 88 | 89 | 93 | 97 | 99 | 100 | 105 | 106 | 107 | 111 | 112 | 113 | 114 | 115 | 116 | 117 | 119 | 120 | 122 | 125) goto validate_connection comment "egress rule 1"
    ip saddr 10.100.3.0/24 reject with icmpx admin-prohibited comment "egress rule 2"
  }
  chain output {
    type route hook output priority mangle; policy accept;
    ct mark & 0xff000000 == 0x0c000000 meta mark set ct mark goto validate_connection
    jump egress_classify_host
  }
  chain egress_classify_host {
    ct direction reply return
    fib daddr type local return
    ip daddr @local_v4 return
    ip6 daddr @local_v6 return
    ip daddr @carrier_v4 return
    ip6 daddr @carrier_v6 return
    ip daddr @fabric_v4 meta mark set 0x0c800100 ct mark set meta mark ct label set (0 | 1 | 2 | 5 | 6 | 8 | 10 | 11 | 13 | 16 | 18 | 19 | 20 | 21 | 22 | 24 | 25 | 26 | 27 | 29 | 30 | 32 | 33 | 34 | 35 | 37 | 40 | 43 | 46 | 47 | 49 | 50 | 51 | 53 | 56 | 57 | 58 | 59 | 60 | 64 | 65 | 66 | 67 | 73 | 74 | 80 | 81 | 82 | 86 | 87 | 90 | 95 | 98 | 99 | 101 | 106 | 108 | 110 | 113 | 115 | 117 | 120 | 122 | 123 | 125 | 127) goto validate_connection comment "egress rule 0"
    ip6 daddr @fabric_v6 meta mark set 0x0c800100 ct mark set meta mark ct label set (0 | 1 | 2 | 5 | 6 | 8 | 10 | 11 | 13 | 16 | 18 | 19 | 20 | 21 | 22 | 24 | 25 | 26 | 27 | 29 | 30 | 32 | 33 | 34 | 35 | 37 | 40 | 43 | 46 | 47 | 49 | 50 | 51 | 53 | 56 | 57 | 58 | 59 | 60 | 64 | 65 | 66 | 67 | 73 | 74 | 80 | 81 | 82 | 86 | 87 | 90 | 95 | 98 | 99 | 101 | 106 | 108 | 110 | 113 | 115 | 117 | 120 | 122 | 123 | 125 | 127) goto validate_connection comment "egress rule 0"
  }
  chain input {
    type filter hook input priority mangle; policy accept;
    ct state new iifname "oc-hub0" ct mark set 0x0c800100 ct label set (0 | 1 | 2 | 5 | 6 | 8 | 10 | 11 | 13 | 16 | 18 | 19 | 20 | 21 | 22 | 24 | 25 | 26 | 27 | 29 | 30 | 32 | 33 | 34 | 35 | 37 | 40 | 43 | 46 | 47 | 49 | 50 | 51 | 53 | 56 | 57 | 58 | 59 | 60 | 64 | 65 | 66 | 67 | 73 | 74 | 80 | 81 | 82 | 86 | 87 | 90 | 95 | 98 | 99 | 101 | 106 | 108 | 110 | 113 | 115 | 117 | 120 | 122 | 123 | 125 | 127)
  }
  chain forward {
    type filter hook forward priority filter; policy accept;
    tcp flags syn / syn,rst tcp option maxseg size set rt mtu
    meta mark & 0xffffff00 { 0x0c800100 } oifname "eth0" reject with icmpx admin-prohibited
    meta mark & 0xff000000 == 0x0c000000 meta mark & 0xffffff00 != { 0x0c800100, 0x0c800000 } reject with icmpx admin-prohibited
  }
  chain postrouting {
    type filter hook postrouting priority filter; policy accept;
    oifname "lo" accept
    tcp flags syn / syn,rst tcp option maxseg size set rt mtu
    meta mark & 0xffffff00 { 0x0c800100 } oifname "eth0" drop
    meta mark & 0xff000000 == 0x0c000000 meta mark & 0xffffff00 != { 0x0c800100, 0x0c800000 } drop
  }
}
table ip kornode_nat {
  chain postrouting {
    type nat hook postrouting priority srcnat; policy accept;
    meta mark & 0xffffff00 == 0x0c800000 oifname != "lo" masquerade
    ip saddr 10.100.3.0/24 ip daddr != 10.100.3.0/24 meta mark & 0xffffff00 == 0x00000000 masquerade
  }
}
