# Generated by kornode. This file defines only project-owned tables.
#
# The add/delete pair below makes the whole file one atomic nft transaction
# (nft applies a single -f invocation all-or-nothing): "add table" first
# guarantees the table exists (a no-op if it already does, so this works
# equally on first boot and on every later reload), then "delete table"
# removes it now that it's guaranteed present, and the table is immediately
# redefined below in the same transaction. If the redefinition fails for any
# reason (e.g. a bad rule), the whole transaction rolls back and the
# previous, still-working table is left untouched -- unlike running
# `nft delete table` as a separate prior command, which would leave the
# kill-switch/NAT missing until the next successful apply.
#
# NftablesService.apply() normally avoids running this full recreate at all
# once this schema is already loaded -- see nftables-static-refresh.nft.j2 --
# because it would otherwise wipe the *_dynamic sets below (every IP
# DomainResolverService has resolved for a configured domain, on its own
# schedule -- see services/domain_resolver.py) on every reload.
# This full definition still has to exist for the first apply and for any
# apply that changes the schema itself (profile added/removed, host routing
# toggled).
add table inet {{ filter_table }}
delete table inet {{ filter_table }}
add table ip {{ nat_table }}
delete table ip {{ nat_table }}

table inet {{ filter_table }} {
{% for target in targets %}
  # split into *_static (this target's config-known routes -- routing.split,
  # profile `routes`/`host_routes`) and *_dynamic (populated only by
  # DomainResolverService, on its own schedule -- see
  # services/domain_resolver.py). A surgical refresh (NftablesService.apply(),
  # see its docstring) refreshes *_static in place (flush + re-add) WITHOUT
  # ever touching *_dynamic -- a single-set design flushed on every refresh
  # would wipe out every resolved domain IP each time, silently breaking any
  # long-lived connection still using one between resolver cycles.
  #
  # auto-merge on all: user-provided route lists routinely contain
  # overlapping CIDRs (e.g. 5.28.192.0/18 alongside 5.28.192.0/21) and
  # DomainResolverService's additions can land inside an already-listed
  # interval; without it nft rejects the whole ruleset with "conflicting
  # intervals".
  set {{ target.set_v4_static }} {
    type ipv4_addr
    flags interval
    auto-merge
{% if target.routes %}
    elements = { {{ target.routes | join(", ") }} }
{% endif %}
  }

  set {{ target.set_v4_dynamic }} {
    type ipv4_addr
    flags interval
    auto-merge
  }

  set {{ target.set_v6_static }} {
    type ipv6_addr
    flags interval
    auto-merge
  }

  set {{ target.set_v6_dynamic }} {
    type ipv6_addr
    flags interval
    auto-merge
  }
{% if target.host_enabled %}
  set {{ target.host_set_v4_static }} {
    type ipv4_addr
    flags interval
    auto-merge
{% if target.host_routes %}
    elements = { {{ target.host_routes | join(", ") }} }
{% endif %}
  }

  set {{ target.host_set_v4_dynamic }} {
    type ipv4_addr
    flags interval
    auto-merge
  }

  set {{ target.host_set_v6_static }} {
    type ipv6_addr
    flags interval
    auto-merge
{% if target.host_routes_v6 %}
    elements = { {{ target.host_routes_v6 | join(", ") }} }
{% endif %}
  }

  set {{ target.host_set_v6_dynamic }} {
    type ipv6_addr
    flags interval
    auto-merge
  }
{% endif %}
{% endfor %}

{% if host_traffic_enabled and host_mode == "split" %}
  # The HOST's own split-mode set pair -- deliberately separate from the
  # client-facing default target's split_v4/v6 above, fed from
  # routing.host_split's own routes/domains, not routing.split's.
  set host_split_v4_static {
    type ipv4_addr
    flags interval
    auto-merge
{% if host_split_routes %}
    elements = { {{ host_split_routes | join(", ") }} }
{% endif %}
  }

  set host_split_v4_dynamic {
    type ipv4_addr
    flags interval
    auto-merge
  }

  set host_split_v6_static {
    type ipv6_addr
    flags interval
    auto-merge
  }

  set host_split_v6_dynamic {
    type ipv6_addr
    flags interval
    auto-merge
  }
{% endif %}

  chain prerouting {
    type filter hook prerouting priority mangle; policy accept;
    # Rendered in target order (default first, then named per-profile
    # targets): a later "meta mark set" overwrites an earlier one, so a
    # profile's own explicit routes/domains correctly take priority over
    # the default's blanket full-mode mark for the same traffic.
{% for target in targets %}
{% if target.name == "default" and not client_traffic_enabled %}
  {# Client traffic through Upstream is off by default (routing.client_policy) --
     this target's set stays populated (routing.host_policy: split shares it) but
     never marks client/forwarded traffic. #}
{% elif target.mode == "split" %}
    ip daddr @{{ target.set_v4_static }} counter meta mark set {{ target.fwmark }}
    ip daddr @{{ target.set_v4_dynamic }} counter meta mark set {{ target.fwmark }}
    ip6 daddr @{{ target.set_v6_static }} counter meta mark set {{ target.fwmark }}
    ip6 daddr @{{ target.set_v6_dynamic }} counter meta mark set {{ target.fwmark }}
{% elif target.mode == "full" %}
    ip saddr {{ config.server.ipv4_network }} counter meta mark set {{ target.fwmark }}
{% endif %}
{% endfor %}
    # The local VPN server subnet is a protected routing domain. Responses
    # and client-to-client traffic must use ocserv per-session /32 routes,
    # never an upstream policy table, even if ingress supplied a mark.
    ip daddr {{ config.server.ipv4_network }} counter meta mark set 0
  }

  chain prerouting_protected {
    # Reverse DNAT runs at priority dstnat (-100), after the mangle chain
    # above. Clear an upstream mark again at -50, when a reply destination
    # has already been restored from the tunnel NAT address to a VPN client.
    type filter hook prerouting priority -50; policy accept;
    ip daddr {{ config.server.ipv4_network }} counter meta mark set 0
  }

{% set host_targets = targets | selectattr("host_enabled") | list %}
{% if upstream_killswitch or host_targets %}
  chain input {
    # Remember which upstream accepted a connection to a local service.
    # The reply must use that same target's policy table; otherwise its
    # initial route lookup follows the main table and can leak a private
    # source address through the public uplink. Marking in the input hook
    # is deliberate: local delivery has already been selected, so this
    # conntrack mark cannot hairpin the inbound packet back into the tunnel.
    type filter hook input priority mangle; policy accept;
{% if upstream_killswitch %}
    iifname "{{ outbound_interface }}" ct direction original ct state new counter ct mark set {{ config.routing.fwmark }}
{% endif %}
{% for target in host_targets %}
    iifname "{{ target.interface }}" ct direction original ct state new counter ct mark set {{ target.fwmark }}
{% endfor %}
  }
{% endif %}

{% if upstream_killswitch or host_traffic_enabled or host_targets %}
  chain output {
    # "route" type: the mark must trigger a fresh route lookup so the
    # packet actually moves to the fwmark policy table.
    type route hook output priority mangle; policy accept;
    # Restore marks only for replies to connections recorded by our input
    # chain above. Restricting the accepted ct marks to this renderer's own
    # targets avoids importing unrelated conntrack marks from other tools.
{% if upstream_killswitch %}
    ct direction reply ip daddr != {{ config.server.ipv4_network }} ct mark {{ config.routing.fwmark }} counter meta mark set {{ config.routing.fwmark }}
{% endif %}
{% for target in host_targets %}
    ct direction reply ip daddr != {{ config.server.ipv4_network }} ct mark {{ target.fwmark }} counter meta mark set {{ target.fwmark }}
{% endfor %}
    # ct direction original: only connections the host itself initiated.
    # Replies not explicitly recorded by our input chain (WAN SSH/panel, or
    # any other non-upstream ingress) keep their normal route even if the
    # peer address happens to land in a split set. The VPN subnet itself is
    # always exempt: the dnsmasq listen address and the
    # clients' per-session /32 routes live there and must never be pulled
    # into the fwmark table.
{% if host_traffic_enabled %}
{% if host_mode == "full" %}
    # Full: mark ALL host-originated traffic, not just the split sets.
    # CAUTION (operator responsibility, same as split routes never covering
    # the upstream server's own address): this also matches the outbound
    # openconnect carrier connection to the upstream server itself unless
    # your network setup already routes that address outside this policy
    # table some other way -- marking it would try to send the tunnel's own
    # traffic through the tunnel it's still establishing, a routing loop.
    # Prefer host_policy: split with a curated route list when precision
    # matters.
    ct direction original ip daddr != {{ config.server.ipv4_network }} counter meta mark set {{ config.routing.fwmark }}
    ct direction original ip6 counter meta mark set {{ config.routing.fwmark }}
{% else %}
    ct direction original ip daddr != {{ config.server.ipv4_network }} ip daddr @host_split_v4_static counter meta mark set {{ config.routing.fwmark }}
    ct direction original ip daddr != {{ config.server.ipv4_network }} ip daddr @host_split_v4_dynamic counter meta mark set {{ config.routing.fwmark }}
    ct direction original ip6 daddr @host_split_v6_static counter meta mark set {{ config.routing.fwmark }}
    ct direction original ip6 daddr @host_split_v6_dynamic counter meta mark set {{ config.routing.fwmark }}
{% endif %}
{% endif %}
    # Per-profile host routing (UpstreamProfileConfig.route_host_enabled):
    # rendered after the default block above, so a later "meta mark set"
    # here takes priority over the default's blanket host_policy mark for the
    # same destination -- same "default first, named overrides win" pattern
    # as the client-side prerouting chain.
{% for target in host_targets %}
    ct direction original ip daddr != {{ config.server.ipv4_network }} ip daddr @{{ target.host_set_v4_static }} counter meta mark set {{ target.fwmark }}
    ct direction original ip daddr != {{ config.server.ipv4_network }} ip daddr @{{ target.host_set_v4_dynamic }} counter meta mark set {{ target.fwmark }}
    ct direction original ip6 daddr @{{ target.host_set_v6_static }} counter meta mark set {{ target.fwmark }}
    ct direction original ip6 daddr @{{ target.host_set_v6_dynamic }} counter meta mark set {{ target.fwmark }}
{% endfor %}
    # Keep locally generated replies to VPN clients on their per-session
    # routes even if another rule restored or supplied an upstream mark.
    ip daddr {{ config.server.ipv4_network }} counter meta mark set 0
  }
{% endif %}

{% if targets | selectattr("killswitch") | list %}
  chain forward {
    type filter hook forward priority filter; policy accept;
    # Marked traffic (default: full = all client traffic, split = the
    # configured routes/ips/domains; named targets: always their own
    # explicit routes/ips/domains) must leave via its target's own upstream
    # interface. If it doesn't -- that upstream is down, disabled, or the
    # policy route hasn't been installed yet -- drop it instead of letting
    # it leak out unencrypted via the host's own connection.
{% for target in targets if target.killswitch %}
    meta mark {{ target.fwmark }} oifname != "{{ target.interface }}" counter drop
{% endfor %}
  }
{% endif %}

{% if upstream_killswitch or host_targets %}
  chain postrouting {
    # The local/reply kill-switch must live in postrouting, NOT in an
    # output-hook filter chain: every chain of one hook point shares the
    # same nf_hook_state, so an output chain still sees the pre-reroute
    # oifname (the uplink) even after the route chain re-routed the packet
    # into the tunnel -- it would drop ALL marked local traffic. Postrouting
    # is a fresh hook invocation and sees the final routing decision.
    type filter hook postrouting priority filter; policy accept;
    # Local delivery (a marked destination that is also an address on this
    # host) legitimately leaves via lo, never the tunnel.
    oifname "lo" accept
{% if upstream_killswitch %}
    meta mark {{ config.routing.fwmark }} oifname != "{{ outbound_interface }}" counter drop
{% endif %}
    # Per-profile host routing is unconditional once a target exists (same
    # "explicitly assigned traffic must not silently leak" philosophy as the
    # client-side forward kill-switch above), regardless of host_policy.
{% for target in host_targets %}
    meta mark {{ target.fwmark }} oifname != "{{ target.interface }}" counter drop
{% endfor %}
  }
{% endif %}
}

table ip {{ nat_table }} {
  chain postrouting {
    type nat hook postrouting priority srcnat; policy accept;
    # Named targets first, so their own connections get NATed via their own
    # interface before the default target's broader (mark-agnostic once
    # active) fallback below gets a chance to claim them too -- a NAT
    # decision is made once per connection, so whichever rule matches first
    # wins and later rules are no-ops for that same connection.
{% for target in targets if target.name != "default" %}
    ip saddr {{ config.server.ipv4_network }} meta mark {{ target.fwmark }} oifname "{{ target.interface }}" masquerade
{% endfor %}
{% if targets[0].killswitch %}
    ip saddr {{ config.server.ipv4_network }} meta mark {{ targets[0].fwmark }} oifname "{{ targets[0].interface }}" masquerade
    ip saddr {{ config.server.ipv4_network }} meta mark != {{ targets[0].fwmark }} masquerade
{% elif targets[0].interface != "auto" %}
    ip saddr {{ config.server.ipv4_network }} oifname "{{ targets[0].interface }}" masquerade
{% else %}
    ip saddr {{ config.server.ipv4_network }} masquerade
{% endif %}
{% if host_traffic_enabled and outbound_interface != "auto" %}
    # Locally originated packets pick their source address before the
    # fwmark re-route, so host traffic redirected into the tunnel still
    # carries the uplink source and replies would never come back;
    # masquerade rewrites it to the tunnel address. (VPN client traffic
    # is already covered by the saddr rules above.)
    meta mark {{ config.routing.fwmark }} oifname "{{ outbound_interface }}" counter masquerade
{% endif %}
{% for target in host_targets %}
    meta mark {{ target.fwmark }} oifname "{{ target.interface }}" counter masquerade
{% endfor %}
  }
}
