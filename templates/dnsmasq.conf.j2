# Generated by kornode. Project-owned dnsmasq instance only.
port={{ config.internal_dns.port }}
listen-address={{ config.internal_dns.listen }}
bind-interfaces
no-hosts
domain-needed
bogus-priv
# Don't cache NXDOMAIN/NODATA: a transient wrong answer from one upstream
# would otherwise stick for the negative TTL, making a single name fail
# for minutes while its neighbours keep resolving.
no-negcache
cache-size={{ config.internal_dns.cache_size }}
{% if config.internal_dns.log_queries %}
log-queries
{% endif %}

{% if upstream_dns %}
# Explicit upstreams only; the host's resolv.conf may point at a container
# or stub resolver with a different view of the same zones.
no-resolv
{% endif %}
{% for dns in upstream_dns %}
server={{ dns }}
{% endfor %}

{% for domain in forward_domains %}
{% for dns in forward_upstreams %}
server=/{{ domain }}/{{ dns }}
{% endfor %}
{% endfor %}

{% if split_dns_active and upstream_dns %}
{% for domain in split_domains %}
{% if domain not in forward_domain_names %}
server=/{{ domain }}/{{ upstream_dns[0] }}
{% endif %}
nftset=/{{ domain }}/4#inet#{{ filter_table }}#{{ split_v4_set }},6#inet#{{ filter_table }}#{{ split_v6_set }}
{% endfor %}
{% endif %}

{% for target in named_targets_with_domains %}
{% for domain in target.domains %}
nftset=/{{ domain }}/4#inet#{{ filter_table }}#{{ target.set_v4_dynamic }},6#inet#{{ filter_table }}#{{ target.set_v6_dynamic }}
{% endfor %}
{% endfor %}

{% for target in named_targets_with_host_domains %}
{% for domain in target.server_domains %}
{% if domain not in forward_domain_names %}
{% for dns in target.server_dns %}
server=/{{ domain }}/{{ dns }}
{% endfor %}
{% endif %}
{% endfor %}
{% for domain in target.host_domains %}
nftset=/{{ domain }}/4#inet#{{ filter_table }}#{{ target.host_set_v4_dynamic }},6#inet#{{ filter_table }}#{{ target.host_set_v6_dynamic }}
{% endfor %}
{% endfor %}

{% for domain in host_split_domains %}
nftset=/{{ domain }}/4#inet#{{ filter_table }}#host_split_v4_dynamic,6#inet#{{ filter_table }}#host_split_v6_dynamic
{% endfor %}

{% for record in local_records %}
address=/{{ record.host }}/{{ record.ip }}
{% endfor %}

{% if config.internal_dns.blocklist_enabled %}
conf-file={{ blocklist_conf }}
{% endif %}
