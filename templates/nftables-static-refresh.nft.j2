# Generated by kornode. Refreshes only the *_static sets in the
# already-loaded {{ filter_table }} table -- deliberately never touches any
# *_dynamic set (dnsmasq-populated) or any other part of the ruleset. See
# NftablesService.apply().
{% for target in targets %}
flush set inet {{ filter_table }} {{ target.set_v4_static }}
{% if target.routes %}
add element inet {{ filter_table }} {{ target.set_v4_static }} { {{ target.routes | join(", ") }} }
{% endif %}
flush set inet {{ filter_table }} {{ target.set_v6_static }}
{% if target.host_enabled %}
flush set inet {{ filter_table }} {{ target.host_set_v4_static }}
{% if target.host_routes %}
add element inet {{ filter_table }} {{ target.host_set_v4_static }} { {{ target.host_routes | join(", ") }} }
{% endif %}
flush set inet {{ filter_table }} {{ target.host_set_v6_static }}
{% if target.host_routes_v6 %}
add element inet {{ filter_table }} {{ target.host_set_v6_static }} { {{ target.host_routes_v6 | join(", ") }} }
{% endif %}
{% endif %}
{% endfor %}
{% if host_split_active %}
flush set inet {{ filter_table }} host_split_v4_static
{% if host_split_routes %}
add element inet {{ filter_table }} host_split_v4_static { {{ host_split_routes | join(", ") }} }
{% endif %}
flush set inet {{ filter_table }} host_split_v6_static
{% endif %}
