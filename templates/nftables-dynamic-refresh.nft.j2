# Generated by kornode. Refreshes only the *_dynamic sets DomainResolverService
# just resolved -- deliberately never touches any *_static set or any other
# part of the ruleset. See DomainResolverService.refresh().
{% for set in resolved %}
flush set inet {{ filter_table }} {{ set.set_v4 }}
{% if set.ips_v4 %}
add element inet {{ filter_table }} {{ set.set_v4 }} { {{ set.ips_v4 | join(", ") }} }
{% endif %}
flush set inet {{ filter_table }} {{ set.set_v6 }}
{% if set.ips_v6 %}
add element inet {{ filter_table }} {{ set.set_v6 }} { {{ set.ips_v6 | join(", ") }} }
{% endif %}
{% endfor %}
