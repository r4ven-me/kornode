; Generated by kornode.
[supervisord]
nodaemon=true
user=root
logfile={{ config.system.log_dir }}/supervisord.log
pidfile={{ config.system.generated_dir }}/supervisord.pid

[unix_http_server]
file={{ config.system.generated_dir }}/supervisor.sock
chmod=0700
username={{ rpc_username }}
password={{ rpc_password }}

[rpcinterface:supervisor]
supervisor.rpcinterface_factory=supervisor.rpcinterface:make_main_rpcinterface

[supervisorctl]
serverurl=unix://{{ config.system.generated_dir }}/supervisor.sock
username={{ rpc_username }}
password={{ rpc_password }}

{% if config.server.enabled %}
[program:ocserv]
; --log-stderr (long form only: ocserv's getopt short-option string omits
; 'e' even though usage() documents "-e, --log-stderr", so "-e" itself
; fails with "invalid option -- 'e'" for both ocserv and ocserv-worker).
; Without it, ocserv logs to syslog by default, which bypasses supervisor's
; stdout capture entirely -- only the handful of messages printed before
; ocserv's logging init ever reach ocserv.log.
command=/usr/sbin/ocserv -f --log-stderr -c {{ config.system.generated_dir }}/ocserv.conf
autorestart=true
stdout_logfile={{ config.system.log_dir }}/ocserv.log
stdout_logfile_maxbytes=0
redirect_stderr=true
{% endif %}

[program:dnsmasq]
; Always register the process so DNS can be enabled through the panel without
; requiring supervisord itself to restart. It starts automatically only when
; the saved configuration needs the project-owned resolver.
command=/usr/local/bin/korctl internal-dns run
autostart={{ "true" if config.dns_tunnel_active() else "false" }}
autorestart=true
stdout_logfile={{ config.system.log_dir }}/dnsmasq.log
stdout_logfile_maxbytes=0
redirect_stderr=true

{% if config.web.enabled %}
[program:api]
command=/usr/local/bin/uvicorn kornode.api.app:create_app --factory --host {{ config.web.listen }} --port {{ config.web.port }}{{ (" --ssl-certfile " ~ config.web_tls_cert_path() ~ " --ssl-keyfile " ~ config.web_tls_key_path()) if config.web.tls else "" }}{{ (" --proxy-headers --forwarded-allow-ips " ~ (config.web.trusted_proxies | join(","))) if config.web.trusted_proxies else "" }}
autorestart=true
stdout_logfile={{ config.system.log_dir }}/api.log
stdout_logfile_maxbytes=0
redirect_stderr=true
{% endif %}

{% if config.upstream.enabled %}
[program:upstream-watchdog]
command=/usr/local/bin/korctl upstream watch
autorestart=true
stdout_logfile={{ config.system.log_dir }}/upstream-watchdog.log
stdout_logfile_maxbytes=0
redirect_stderr=true
{% endif %}

{% if config.certificates.letsencrypt.enabled and config.certificates.letsencrypt.auto_renew_enabled %}
[program:certbot-renew]
command=/bin/sh -c 'while true; do certbot --config-dir {{ config.system.data_dir }}/certbot/config --work-dir {{ config.system.data_dir }}/certbot/work --logs-dir {{ config.system.log_dir }}/certbot renew --reuse-key{% if config.certificates.letsencrypt.renew_reload %} && supervisorctl -c {{ config.system.generated_dir }}/supervisor.conf signal HUP ocserv || true{% endif %}; sleep {{ config.certificates.letsencrypt.auto_renew_interval_seconds }}; done'
autorestart=true
stdout_logfile={{ config.system.log_dir }}/certbot-renew.log
stdout_logfile_maxbytes=0
redirect_stderr=true
{% endif %}

[program:host-dns-guard]
; Always registered, like dnsmasq above: a no-op loop while
; routing.host_dns is off, so enabling it in the panel needs no supervisord
; restart. Keeps the host resolver pointed at dnsmasq and restores the
; host's own resolv.conf on SIGTERM (container stop).
command=/usr/local/bin/korctl host-dns guard
autorestart=true
stopwaitsecs=15
stdout_logfile={{ config.system.log_dir }}/host-dns.log
stdout_logfile_maxbytes=0
redirect_stderr=true

[program:log-rotation]
; Runs unconditionally: korctl re-reads the config on every cycle and is a
; no-op while system.log_rotation.enabled is false, so toggling rotation in
; the panel takes effect without regenerating this file.
command=/bin/sh -c 'while true; do korctl logs-rotate || true; sleep 300; done'
autorestart=true
stdout_logfile={{ config.system.log_dir }}/log-rotation.log
stdout_logfile_maxbytes=0
redirect_stderr=true
