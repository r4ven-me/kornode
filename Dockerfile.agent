# kornode-agent image (spec 06): the agent only, none of the hub.
# Build: docker build -f Dockerfile.agent -t kornode-agent .
FROM python:3.12-slim-trixie

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    KORNODE_AGENT_DIR=/var/lib/kornode-agent

# openconnect/nftables/iproute2 are the data plane; vpnc-scripts is used by the
# short-lived enroll session; iputils-ping backs the upstream check_host probe;
# dnsmasq-base is the node resolver (P4-03, no Debian service/unit files).
# ocserv is the access server of role access (P4-04); iptables only for the doctor's
# read-only look at a source server's legacy NAT rules (P4-05).
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates dnsmasq-base iproute2 iptables iputils-ping nftables ocserv openconnect \
        supervisor vpnc-scripts \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/kornode
COPY pyproject.toml README.md ./
COPY backend ./backend
# The agent imports only kornode.net/bundle/tunnels and kornode_agent, so the
# hub's dependencies (FastAPI, uvicorn, typer, jinja2, ...) are not installed.
# Keep the shared cryptography floor aligned with pyproject.toml. System ocserv
# comes from Debian's authenticated apt repository, not an unchecked tarball.
RUN pip install --no-cache-dir 'cryptography>=44,<46' 'httpx>=0.27,<1' 'pydantic>=2.7,<3' \
        'pyroute2>=0.7,<1' 'pyyaml>=6,<7' \
    && pip install --no-cache-dir --no-deps . \
    && kornode-agent version

COPY agent/supervisord.conf /etc/supervisor/conf.d/kornode-agent.conf
VOLUME /var/lib/kornode-agent
ENTRYPOINT ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/kornode-agent.conf"]
