{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kornode.r4ven.me/schemas/egress.v1.schema.json",
  "title": "kornode egress policy v1",
  "description": "Reader schema, including D-84/D-85 aliases. Writers normalize fabric to interlink and exit:<n> to node:<n>. Semantic checks (references, CIDRs, compilation) also run in Python.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" },
      "default": []
    },
    "sets": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": { "$ref": "#/$defs/destSet" },
      "default": {}
    },
    "egress": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" },
      "default": []
    }
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,30}$" },
    "cidr": {
      "type": "string",
      "description": "IPv4 or IPv6 network in CIDR notation; a host is /32 or /128",
      "pattern": "^([0-9]{1,3}(\\.[0-9]{1,3}){3}/[0-9]{1,2}|[0-9a-fA-F:]+/[0-9]{1,3})$"
    },
    "domain": {
      "type": "string",
      "pattern": "^(\\*\\.)?([A-Za-z0-9-]{1,63}\\.)+[A-Za-z]{2,63}$"
    },
    "url": { "type": "string", "pattern": "^https?://" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "interface", "cidr"],
      "properties": {
        "name": { "allOf": [{ "$ref": "#/$defs/name" }, { "not": { "enum": ["clients", "host", "fabric", "interlink"] } }] },
        "interface": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,15}$" },
        "cidr": { "$ref": "#/$defs/cidr" },
        "export": { "type": "boolean", "default": true },
        "allow_outside_pool": { "type": "boolean", "default": false },
        "description": { "type": "string", "maxLength": 200 }
      }
    },
    "destSet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "routes": { "type": "array", "items": { "$ref": "#/$defs/cidr" }, "default": [] },
        "domains": { "type": "array", "items": { "$ref": "#/$defs/domain" }, "default": [] },
        "route_urls": { "type": "array", "items": { "$ref": "#/$defs/url" }, "default": [] },
        "domain_urls": { "type": "array", "items": { "$ref": "#/$defs/url" }, "default": [] }
      }
    },
    "from": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "not": { "allOf": [{ "contains": { "const": "fabric" } }, { "contains": { "const": "interlink" } }] },
      "items": {
        "anyOf": [
          { "enum": ["clients", "host", "interlink", "fabric"] },
          { "$ref": "#/$defs/name" }
        ]
      }
    },
    "to": {
      "oneOf": [
        { "enum": ["any", "interlink", "fabric"] },
        {
          "type": "object", "additionalProperties": false, "required": ["set"],
          "properties": { "set": { "$ref": "#/$defs/name" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["node"],
          "properties": { "node": { "type": "integer", "minimum": 1, "maximum": 254 } }
        },
        {
          "type": "object", "additionalProperties": false,
          "anyOf": [ { "required": ["routes"] }, { "required": ["domains"] } ],
          "properties": {
            "routes": { "type": "array", "items": { "$ref": "#/$defs/cidr" } },
            "domains": { "type": "array", "items": { "$ref": "#/$defs/domain" } }
          }
        }
      ]
    },
    "via": {
      "type": "string",
      "pattern": "^(local|interlink|fabric|drop|(?:node|exit):([1-9][0-9]{0,2})|upstream:[a-z][a-z0-9_-]{0,30})$"
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "via"],
      "properties": {
        "id": { "$ref": "#/$defs/name" },
        "from": { "$ref": "#/$defs/from" },
        "to": { "$ref": "#/$defs/to" },
        "via": { "$ref": "#/$defs/via" },
        "kill_switch": { "type": "boolean" },
        "description": { "type": "string", "maxLength": 200 }
      }
    }
  }
}
