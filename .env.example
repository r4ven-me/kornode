# kornode env override examples
KORNODE_CONFIG=/etc/kornode/config.yaml
KORNODE_SYSTEM__LOG_LEVEL=info
KORNODE_SERVER__PORT=443
KORNODE_WEB__ENABLED=false
KORNODE_WEB__LISTEN=127.0.0.1
KORNODE_WEB__PORT=8443
KORNODE_WEB__TLS=true
KORNODE_WEB__ALLOW_INSECURE_HTTP=false
# Required when KORNODE_WEB__ENABLED=true unless compose.web.yaml injects it.
# KORNODE_WEB__ADMIN_PASSWORD=change-me
# Production alternative:
# KORNODE_WEB__ADMIN_PASSWORD_HASH='scrypt$...'

# For local host access to the optional Web UI, use compose.web.yaml.
# For a TLS-terminating reverse proxy, set KORNODE_WEB__TLS=false and
# KORNODE_WEB__ALLOW_INSECURE_HTTP=true, configure trusted proxy IP/CIDR, and
# do not expose port 8443 publicly.
# KORNODE_WEB__TRUSTED_PROXIES='["127.0.0.1"]'

# Secrets referenced by config.yaml via ${SECRET:NAME}
KORNODE_ADMIN_PASSWORD=change-me
# KORNODE_ADMIN_PASSWORD_HASH='scrypt$...'
OIDC_CLIENT_SECRET=change-me
PRIVATE_MAIN_P12_PASSWORD=change-me
PRIVATE_BACKUP_PASSWORD=change-me

# Lists are JSON.
# KORNODE_SERVER__DNS='["1.1.1.1", "8.8.8.8"]'
