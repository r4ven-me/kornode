# KORNODE env override examples

KORNODE_CONFIG=/etc/kornode/config.yaml
KORNODE_SYSTEM__LOG_LEVEL=info
KORNODE_SERVER__PORT=443
KORNODE_WEB__ENABLED=false
KORNODE_WEB__LISTEN=127.0.0.1
KORNODE_WEB__PORT=8443

# Secrets referenced by config.yaml via ${SECRET:NAME}
KORNODE_ADMIN_PASSWORD=change-me
PRIVATE_MAIN_P12_PASSWORD=change-me
PRIVATE_BACKUP_PASSWORD=change-me

# Example list override as JSON
# KORNODE_SERVER__DNS='["1.1.1.1", "8.8.8.8"]'
